# Code and styles change with each release: check for a newer copy after five minutes.
/*.js
  Cache-Control: public, max-age=300
/*.css
  Cache-Control: public, max-age=300

/fonts/*
  Cache-Control: public, max-age=2592000

# Fetched as /data/...?v=<release>, so a new release always gets new files.
/data/*
  Cache-Control: public, max-age=3600

# The same list as lib/security.js (pages a Function builds don't get these rules): keep the two in step.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()
